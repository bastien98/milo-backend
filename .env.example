# App
APP_NAME=Scandalicious Backend
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://localhost:5432/scandalicious

# Firebase Auth (provide one of these)
FIREBASE_SERVICE_ACCOUNT=  # JSON string
GOOGLE_APPLICATION_CREDENTIALS=  # File path

# Google Gemini
GEMINI_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# Veryfi OCR (legacy)
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=

# Observability - Axiom (optional, falls back to stdout)
AXIOM_API_TOKEN=
AXIOM_DATASET=

# Observability - Sentry (optional)
SENTRY_DSN=
